# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# scratch / editor temp files
*.tmp

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*.local
.env
# ...and any backup of one. `.env*.local` does NOT match `.env.local.bak-*`,
# so a rotated copy was one `git add -A` away from committing live keys.
.env.local.*
.env.*.bak*
*.env.bak*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# VPPS import workbooks and backup snapshots (sensitive student data)
/data/imports/*.xlsx
/data/imports/backups/
/docs/import-previews/*/apply-reports/
/docs/import-previews/*/backups/
.playwright-mcp/

# Smoke-test runs and import previews — contain real student PII, exports,
# Playwright traces, and HAR files with auth tokens. Never commit.
/docs/smoke-reports/
/tests/smoke-*/.auth/
/tests/smoke-*/smoke-results.jsonl
/tests/smoke-*/*.xlsx
/tests/deep/.auth/
/tests/deep/**/*.xlsx

# The deep harness splits its output deliberately. Everything bulky — traces,
# videos, downloads, the raw JSONL streams — and, importantly, EVERY
# screenshot stays under the ignored /docs/smoke-reports/deep/<runId>/ above.
# A screenshot of this app is a picture of a class list: real names, phone
# numbers and balances. It is the most PII-dense artifact the harness produces,
# so none of it is committed.
#
# What IS committed is docs/qa/deep-test/: the rendered report, the merged
# findings and the coverage ledger. Those carry route paths, rule names, counts
# and error text — no student names, no phone numbers, no env values (checked).
# A findings document nobody can read next month is not a deliverable, and every
# finding carries a `repro` command that regenerates its screenshot on demand.
!/docs/qa/deep-test/
/docs/qa/deep-test/evidence/
/docs/history/import-previews/
*.har

# DB dumps and migration scratch (contain real student/auth data — never commit)
/.region-migration/
/scratch/
.codex-*.txt
.codex-*.log

# 2026-05-24 revamp artefacts — contain real student/parent PII; never commit
/backups/
/scripts/_revamp/out/

# Claude Code local/personal settings (project settings.json is committed)
/.claude/settings.local.json
/.claude/launch.json

# Prev-year dues import snapshots — contain real student names/dues (PII); never commit
/prevyear_*.json
/prevyear_batch_id.txt

# Claude Code Superpowers plugin plans (ephemeral agent artefacts)
/docs/superpowers/
.codex/

# QA credentials — never committed. See docs/qa/smoke-test-data.md.
docs/qa/*.local.md

# cloud environment (generated by scripts/cloud/use-env.sh)
.env.profile
.env.vercel

# Claude Code session worktrees. A gitlink to one was committed by accident in
# d15d2d5; it is not a registered submodule (there is no .gitmodules), so it only
# ever showed up as a phantom modification.
/.claude/worktrees/
