{
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "quality:budgets": "node scripts/check-quality-budgets.mjs",
    "schema:snapshot": "node scripts/generate-schema-snapshot.mjs",
    "schema:snapshot:check": "node scripts/generate-schema-snapshot.mjs --check",
    "quality:bundles": "node scripts/measure-route-bundles.mjs",
    "quality:bundles:check": "node scripts/measure-route-bundles.mjs --check",
    "smoke:readiness": "playwright test -c tests/smoke-readiness/readiness.config.ts",
    "smoke:readiness:headed": "playwright test -c tests/smoke-readiness/readiness.config.ts --headed",
    "smoke:readiness:auth": "node scripts/capture-readiness-auth.mjs",
    "smoke:readiness:visual": "playwright test -c tests/smoke-readiness/readiness.config.ts visual-a11y.spec.ts",
    "smoke:deep": "playwright test -c tests/smoke-2026-05/smoke.config.ts",
    "smoke:deep:auth": "playwright test -c tests/smoke-2026-05/smoke.config.ts --project=setup",
    "smoke:rbac": "playwright test -c tests/smoke-2026-05/smoke.config.ts --project=rbac-admin --project=rbac-accountant --project=rbac-teacher --project=rbac-collector --project=rbac-viewonly",
    "bootstrap:staff": "node scripts/bootstrap-staff.mjs",
    "bootstrap:test-staff": "node scripts/bootstrap-test-staff.mjs",
    "verify:fee-health": "node scripts/verify-live-fee-health.mjs",
    "verify:late-fee-health": "node scripts/verify-late-fee-health.mjs",
    "verify:mcp-health": "node scripts/verify-mcp-health.mjs",
    "mcp:schoolfees:worker:deploy": "wrangler deploy --config workers/schoolfees-mcp/wrangler.toml",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.68.0",
    "@supabase/ssr": "0.10.2",
    "@supabase/supabase-js": "2.104.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.511.0",
    "next": "16.2.12",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "^3.3.6",
    "@next/bundle-analyzer": "^16.2.12",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "critters": "^0.0.23",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "supabase": "^2.98.0",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "body-parser": "2.3.0",
    "fast-uri": "4.1.1",
    "hono": "4.12.32",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.16"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.8"
    },
    "postcss": "$postcss",
    "sharp": "0.35.3"
  }
}
